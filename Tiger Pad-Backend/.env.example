
# ============================================================
# TIGERPAD - ENVIRONMENT CONFIGURATION TEMPLATE
# Jackson State University Career Accelerator
#
# Matches TP_App/config.py
# ============================================================
#
# This file contains EXAMPLE settings only.
# Keep actual passwords, API keys, and secrets in .env.
#
# Do not put real credentials in this file.
# ============================================================


# ------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------

APP_NAME=TigerPad
APP_VERSION=0.1.0
APP_DESCRIPTION=JSU Career Accelerator Backend API

ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api


# ------------------------------------------------------------
# MYSQL DATABASE
# ------------------------------------------------------------

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=tigerpad
DATABASE_USER=tigerpad_web
DATABASE_PASSWORD=REPLACE_WITH_YOUR_MYSQL_PASSWORD

DATABASE_DRIVER=mysql+pymysql
DATABASE_CHARSET=utf8mb4

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false


# ------------------------------------------------------------
# GROQ AI CONFIGURATION
# ------------------------------------------------------------

GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

AI_FEATURES_ENABLED=true
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1500
AI_MAX_INPUT_CHARACTERS=12000


# ------------------------------------------------------------
# TIGERPAD AI SCOPE
# ------------------------------------------------------------

AI_OUT_OF_SCOPE_MESSAGE="I can only assist with TigerPad career-readiness topics, including resumes, skills, projects, certifications, career paths, interview preparation, professional development, and JSU career resources."

AI_ALLOWED_TOPICS="resume writing,resume analysis,career paths,career readiness,skills,skill gaps,projects,certifications,work experience,interview preparation,professional development,academic programs,student career goals,JSU career resources"

AI_BLOCKED_TOPICS="illegal activity,malware creation,credential theft,academic cheating,violent wrongdoing,sexual content,unrelated entertainment,unrelated general conversation"


# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------

JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------
# ACCOUNT SECURITY
# ------------------------------------------------------------

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
MINIMUM_PASSWORD_LENGTH=12

PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24

ALLOWED_EMAIL_DOMAINS=jsums.edu

EXPOSE_DEVELOPMENT_SECURITY_TOKENS=false


# ------------------------------------------------------------
# FRONTEND AND CORS
# ------------------------------------------------------------

FRONTEND_URL=http://localhost:5173

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ------------------------------------------------------------
# RESUME UPLOADS
# ------------------------------------------------------------

UPLOAD_DIRECTORY=TP_App/uploads

MAX_UPLOAD_SIZE_MB=10

ALLOWED_RESUME_EXTENSIONS=.pdf,.docx

# Enable only after installing and verifying ClamAV.
FILE_SCANNING_ENABLED=false
FILE_SCANNER_COMMAND=clamdscan


# ------------------------------------------------------------
# API RATE LIMITING
# ------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

AUTH_RATE_LIMIT_REQUESTS=10
RATE_LIMIT_MAX_KEYS=10000


# ------------------------------------------------------------
# DEPLOYMENT
# ------------------------------------------------------------

DEPLOYMENT_PLATFORM=local

# Local HTTP development settings.
# HTTPS must be configured before enabling it.
REQUIRE_HTTPS=false
SECURE_COOKIES=false
COOKIE_AUTH_ENABLED=false


# ============================================================
# PRODUCTION CHECKLIST
# ============================================================
#
# Before deploying:
#
# ENVIRONMENT=production
# DEBUG=false
# DEPLOYMENT_PLATFORM=Render
# REQUIRE_HTTPS=true
# SECURE_COOKIES=true
# RATE_LIMIT_ENABLED=true
# FILE_SCANNING_ENABLED=true
# EXPOSE_DEVELOPMENT_SECURITY_TOKENS=false
#
# Replace all example credentials in the PRIVATE .env.
#
# Configure the actual deployed frontend URL.
#
# Confirm malware scanning works before enabling uploads.
#
# Review cookie authentication with the frontend before
# changing COOKIE_AUTH_ENABLED.
#
# Never commit your real .env file.
#
# ============================================================
